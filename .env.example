# omnimd 配置模板——复制为 .env 填入真实值；注释独立成行，值行不写注释
# 凭据按需配置：图片任务需 VLM 三项；--images link 需对象存储五项；只转文档可不配任何凭据

# ===== VLM 视觉模型 =====
VLM_API_KEY=your_vlm_api_key
# 任意 OpenAI 兼容端点
VLM_BASE_URL=your_vlm_base_url
VLM_MODEL=your_vision_model
# 单图任务输出上限
VLM_MAX_TOKENS=8192
# 单次调用超时（秒）；SDK 缺省 600s 过长，挂起时无反馈
VLM_TIMEOUT=300
# 图片任务并发数
VLM_CONCURRENCY=8
# 思考控制方式（同一家族的云端 API 与开源权重可能分属不同协议，按端点形态选）：
#   none             不发思考参数（缺省）——无思考能力的模型，或不接受未知参数的端点
#   thinking-off|on  {"thinking": {"type": …}}——云端 API：DeepSeek、智谱 GLM 及多数聚合网关
#   template-off|on  {"chat_template_kwargs": …}——自部署权重：vLLM / Ollama / SGLang
#   effort-off|on    {"reasoning_effort": …}——档位制：Grok、Gemini 兼容层等
#   both-off|on      两组参数同发——同一入口混合路由两种协议渠道
VLM_THINKING=none

# ===== 解析引擎与缓存目录 =====
# markitdown 支持的格式最多（缺省）/ anydoc 正文质量优先
DOC_ENGINE=markitdown
# 任务产物/URL 缓存目录（缺省为系统用户缓存目录；相对路径相对于本文件所在目录）
CACHE_DIR=

# ===== 对象存储（S3 兼容；--images link 时必配，embed 内嵌或只转文档可不配）=====
# 不配 = 不使用存储；配置则五项齐全（缺一即报错）；桶需开放匿名只读
S3_ENDPOINT_URL=your_s3_endpoint
S3_REGION=your_s3_region
S3_BUCKET=your_s3_bucket
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# 可选：桶内目录隔离
S3_KEY_PREFIX=your_key_prefix/
