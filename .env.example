# omnimd 配置模板——复制为 .env 填入真实值
# 校验规则：凭据按消费方惰性校验——产出含转写/描述部件时 VLM 凭据三项缺一即报错，
# 产出含 url 部件时存储必填；纯解析（OUTPUT=body）不需要任何凭据；运行参数缺省值见各变量注释

# ===== VLM 视觉模型 =====
VLM_API_KEY=your_vlm_api_key
VLM_BASE_URL=your_vlm_base_url      # 任意 OpenAI 兼容端点
VLM_MODEL=your_vision_model
VLM_MAX_TOKENS=8192                 # 单图转写输出上限
VLM_CONCURRENCY=8                   # 转写并发数
# 思考控制方式（同一家族的云端 API 与开源权重可能分属不同协议，按端点形态选）：
#   none             不发思考参数（缺省）——无思考能力的模型，或不接受未知参数的端点
#   thinking-off|on  {"thinking": {"type": …}}——云端 API：DeepSeek、智谱 GLM 及多数聚合网关
#   template-off|on  {"chat_template_kwargs": …}——自部署权重：vLLM / Ollama / SGLang
#   effort-off|on    {"reasoning_effort": …}——档位制：Grok、Gemini 兼容层等
#   both-off|on      两组参数同发——同一入口混合路由两种协议渠道
VLM_THINKING=none

# ===== 产出组成 =====
OUTPUT=body                         # 逗号分隔多选：body（正文，必选锚点）/ url / base64 / ocr / alt
                                    # url 与 base64 互斥；ocr/alt 依赖 url 或 base64；缺省 body（纯解析）

# ===== 解析引擎与缓存目录 =====
DOC_ENGINE=markitdown               # markitdown 支持的格式最多（缺省）/ anydoc 正文质量优先
CACHE_DIR=                            # 可选：转写/URL 缓存目录（缺省为系统用户缓存目录）

# ===== 文件存储（按需必填：产出含 url 部件时；base64 内嵌或纯解析可不配）=====
STORAGE_PROVIDER=s3                 # s3 = S3 兼容对象存储
S3_ENDPOINT_URL=your_s3_endpoint    # S3 兼容端点（MinIO / OBS / OSS / COS 等）；桶需开放匿名只读
S3_REGION=your_s3_region
S3_BUCKET=your_s3_bucket
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_KEY_PREFIX=your_key_prefix/      # 可选：桶内目录隔离
